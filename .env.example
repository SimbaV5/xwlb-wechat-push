# 复制本文件为 .env 并填入你的 token（本地运行时使用）
# GitHub Actions 部署时不需要 .env，token 配置在仓库 Secrets 中

# PushPlus 用户 token（微信扫码登录 https://www.pushplus.plus 后在首页获取）
PUSHPLUS_TOKEN=

# 单条推送最大字符数，超出会自动分段（微信单条消息过长会被截断）
PUSH_MAX_CHARS=12000

# 推送模板：markdown 或 txt
PUSH_TEMPLATE=markdown

# 当天文字稿未发布时是否回退到最近有数据的日期：1 开启 / 0 关闭
CCTV_FALLBACK=1
